# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Testing
coverage/
.vitest-cache/

# Environment files (never commit)
.env
.env.local
.env.*.local
!.env.example

# Editor
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / temp
*.pid
*.seed
*.pid.lock
tmp/
temp/
.cache/

# Rendered video artifacts (never commit large binaries)
*.mp4
*.mov
*.webm
*.mkv
!docs/**/*.mp4

# Generated assets
*.local

# Vercel
.vercel/

# Sentry
.sentryclirc

# Changesets
.changeset/*.md
!.changeset/README.md
!.changeset/config.json

# Sandbox-only overrides (never commit — reproducible builds rely on
# the tracked tsconfig.json per package, not environment-specific
# typeRoots/paths hacks).
tsconfig.sandbox.json

# Scratch commit-message staging (Jean passes these to `git commit -F`)
.cmsgs/
