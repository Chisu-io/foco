{
  "name": "@chisu/brand-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Brand tokens, template registry, and style enforcement for Foco. Proprietary.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chisu-io/foco.git",
    "directory": "packages/brand-engine"
  },
  "license": "SEE LICENSE IN ../../LICENSE-PROPRIETARY",
  "author": "Chisu <hello@chisu.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
