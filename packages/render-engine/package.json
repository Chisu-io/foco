{
  "name": "@chisu/render-engine",
  "version": "0.0.0",
  "description": "Revideo-based programmatic video composition primitives for vertical short-form video.",
  "keywords": [
    "video",
    "revideo",
    "short-form",
    "vertical",
    "9:16",
    "composition"
  ],
  "homepage": "https://github.com/chisu-io/foco/tree/main/packages/render-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/chisu-io/foco.git",
    "directory": "packages/render-engine"
  },
  "bugs": {
    "url": "https://github.com/chisu-io/foco/issues"
  },
  "license": "Apache-2.0",
  "author": "Chisu <hello@chisu.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
