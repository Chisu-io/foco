{
  "name": "@chisu/media-primitives",
  "version": "0.0.0",
  "description": "FFmpeg utilities, codec profiles, and color pipelines for short-form vertical video.",
  "keywords": [
    "ffmpeg",
    "video",
    "codec",
    "loudness",
    "color",
    "bt709"
  ],
  "homepage": "https://github.com/chisu-io/foco/tree/main/packages/media-primitives",
  "repository": {
    "type": "git",
    "url": "https://github.com/chisu-io/foco.git",
    "directory": "packages/media-primitives"
  },
  "bugs": {
    "url": "https://github.com/chisu-io/foco/issues"
  },
  "license": "Apache-2.0",
  "author": "Chisu <hello@chisu.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
