{
  "name": "@chisu/schemas",
  "version": "0.0.0",
  "description": "Canonical JSON Schema 2020-12 definitions (SSoT) for Foco core contracts: RenderRequest, MemoryItem, UserQuota, IngestAuditEntry, SystemAuditEntry, McpAuthorization. Zod mirrors for TypeScript consumers.",
  "keywords": [
    "json-schema",
    "zod",
    "schemas",
    "foco",
    "contracts",
    "validation"
  ],
  "homepage": "https://github.com/chisu-io/foco/tree/main/packages/schemas",
  "repository": {
    "type": "git",
    "url": "https://github.com/chisu-io/foco.git",
    "directory": "packages/schemas"
  },
  "bugs": {
    "url": "https://github.com/chisu-io/foco/issues"
  },
  "license": "Apache-2.0",
  "author": "Chisu <hello@chisu.io>",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./json": {
      "types": "./src/json.ts",
      "import": "./src/json.ts"
    },
    "./schemas/*.json": "./schemas/*.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./json": {
        "types": "./dist/json.d.ts",
        "import": "./dist/json.js"
      },
      "./schemas/*.json": "./schemas/*.json"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
