{
  "name": "@foco/render-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Foco render POC — 3s face-cam + word-level captions en 9:16 / 1:1 / 16:9, driven by the @chisu/schemas RenderRequest contract.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "render": "tsx src/render.ts",
    "clean": "rm -rf dist .turbo coverage out"
  },
  "dependencies": {
    "@chisu/schemas": "workspace:*",
    "@revideo/2d": "^0.10.1",
    "@revideo/core": "^0.10.1",
    "@revideo/renderer": "^0.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
